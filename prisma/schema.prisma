// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// prisma/schema.prisma

model User {
  id            String   @id @default(uuid()) // ไอดีภายในระบบของเรา
  lineId        String   @unique              // ไอดีของ LINE (สำคัญ ต้อง Unique)
  displayName   String
  pictureUrl    String?  // เผื่อบางคนไม่ได้ตั้งรูปโปรไฟล์
  statusMessage String?  // สเตตัสที่ตั้งใน LINE
  email         String?  // อีเมลที่ผูกกับ LINE
  userName      String?  // ชื่อที่ตั้งใน การลงทะเบียน
  phone         String?  // เบอร์ติดต่อ — กรอกตอนลงทะเบียนผ่านเว็บ
  birthday      String?  // วันเกิด เก็บเป็น "YYYY-MM-DD" ตามที่ input[type=date] ส่งมา
  registeredAt  DateTime? // เวลาที่ลงทะเบียนสำเร็จ (= ตอน LINE ยืนยัน account link)
  isFollowing   Boolean  @default(true)       // สถานะว่ายังติดตามบอทอยู่ไหม
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AutoReply {
  id        String    @id @default(uuid())
  keyword   String    @unique // คำค้นหา เช่น "สวัสดี", "product"
  matchType MatchType @default(EXACT)
  payload   Json      // เก็บข้อมูล JSON ก้อนใหญ่ (messages, showLoading)
  isActive  Boolean   @default(true) // เปิด/ปิด การใช้งานคีย์เวิร์ดนี้
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // สร้าง Index เพื่อให้การค้นหา Keyword เร็วขึ้น
  @@index([keyword])
}

// กำหนด Enum สำหรับประเภทการจับคู่คำ
enum MatchType {
  EXACT     // ต้องพิมพ์ตรงตัวเป๊ะๆ
  CONTAINS  // พิมพ์แค่มีคำนี้ผสมอยู่ก็ทำงาน
}

model RichMenu {
  id          String   @id @default(uuid())
  richMenuId  String?  @unique // เก็บ ID ที่ LINE ส่งกลับมาให้ตอนสร้างเสร็จ
  aliasId     String?  @unique
  name        String   // ชื่อเมนู (เอาไว้แสดงผลในตาราง Dashboard ของเราให้ดูง่ายๆ)
  imageUrl    String   // ลิงก์รูปภาพ (เอาไว้โชว์พรีวิวในหน้าเว็บ และให้ API หลังบ้านโหลดไปส่งให้ LINE)
  payload     Json     // วาง JSON ทั้งก้อนที่ก๊อปมาจาก LINE Bot Designer (มี size, chatBarText, areas ครบจบในช่องเดียว)
  isDefault   Boolean  @default(false) // ระบุว่าเมนูนี้เป็น Default (แสดงทุกคน) หรือไม่
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([richMenuId])
}

// ===========================================================================
// ระบบร่างเอกสารแบบถาม-ตอบทีละขั้น
//
// ปัญหาที่แก้: ถ้าให้ครูพิมพ์ prompt เอง ผลลัพธ์จะไม่สม่ำเสมอและมักขาดข้อมูล
// ระบบนี้ถามทีละช่องจนครบ แล้วค่อยประกอบ prompt ให้ Gemini เอง
// ครูไม่ต้องรู้จัก prompt เลย
//
// แอดมินเพิ่ม/แก้ประเภทเอกสารและคำถามได้เองจาก /dashboard/document
// ===========================================================================

model DocumentType {
  id             String  @id @default(uuid())
  name           String // ชื่อที่แสดงให้ครูเห็น เช่น "หนังสือขออนุญาต"
  triggerKeyword String  @unique // คำที่ครูพิมพ์เพื่อเริ่ม เช่น "ร่างหนังสือขออนุญาต"
  description    String? // คำอธิบายสั้น ๆ ในหน้าเลือกประเภท
  // คำสั่งเพิ่มเติมที่จะต่อท้าย prompt เช่น รูปแบบหนังสือราชการที่ต้องการ
  promptTemplate String
  isActive       Boolean @default(true)
  sortOrder      Int     @default(0)

  fields    DocumentField[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([sortOrder])
}

model DocumentField {
  id             String  @id @default(uuid())
  documentTypeId String
  label          String // ชื่อช่อง เช่น "เรื่อง" — ใช้ตอนสรุปและตอนประกอบ prompt
  question       String // ประโยคที่บอทถาม เช่น "เรื่องอะไรคะ"
  hint           String? // ตัวอย่างคำตอบ ช่วยให้ครูตอบได้ตรง
  isRequired     Boolean @default(true)
  sortOrder      Int     @default(0)

  documentType DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  @@index([documentTypeId, sortOrder])
}

/// สถานะการสนทนาของครูแต่ละคน — 1 คนทำได้ทีละ 1 เอกสาร จึงใช้ lineId เป็น PK
///
/// เก็บใน DB ไม่ใช่ memory เพราะบน Vercel จะหายตอน instance ถูกรีไซเคิล
/// และถ้ามีหลาย instance คนละตัวจะจำสถานะคนละอย่าง
model ConversationState {
  lineId         String   @id
  documentTypeId String
  stepIndex      Int      @default(0)
  answers        Json     @default("{}")
  /// collecting = กำลังถามทีละช่อง, confirming = ถามยืนยันก่อนส่งให้ Gemini
  status         String   @default("collecting")
  /// ค้างไว้นานเกินต้องหลุดเอง ไม่งั้นครูกลับมาพิมพ์อีกทีจะโดนจับเข้าโหมดเดิม
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([expiresAt])
}

// ===========================================================================
// ความรู้และบุคลิกของน้องกรีน (Gemini system prompt)
//
// เดิม prompt ทั้งก้อนถูก hardcode ใน services/geminiService.ts แปลว่าเวลาโรงเรียน
// เปลี่ยนเบอร์โทรหรือเวลาเรียน ต้องแก้โค้ดแล้ว deploy ใหม่
// แยกออกเป็น 2 ส่วนโดยตั้งใจ:
//   - BotPersona = โครงที่แทบไม่เปลี่ยน (บุคลิก ขอบเขต ข้อห้าม) แก้ได้แต่ไม่ค่อยแตะ
//   - SchoolInfo = ข้อมูลที่เปลี่ยนจริง แยกเป็นรายหัวข้อ เปิด/ปิดทีละอันได้
// ที่ไม่รวมเป็น textarea เดียว เพราะข้อห้ามเป็น guardrail ไม่ควรอยู่ห่างจาก
// การเผลอ Ctrl+A ลบทิ้งแค่ครั้งเดียว
// ===========================================================================

model BotPersona {
  // ใช้แถวเดียวตลอด ล็อก id ไว้กันเผลอสร้างหลายแถว
  id        String   @id @default("singleton")
  persona   String // บุคลิกและสไตล์การพูด
  scope     String // ขอบเขตการทำงาน
  rules     String // ข้อห้ามเด็ดขาด
  updatedAt DateTime @updatedAt
}

model SchoolInfo {
  id        String   @id @default(uuid())
  topic     String   @unique // เช่น "ติดต่อ / ฉุกเฉิน"
  content   String
  isActive  Boolean  @default(true) // ปิดชั่วคราวได้โดยไม่ต้องลบ
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// ===========================================================================
// Better Auth — บัญชีแอดมินที่ล็อกอินเข้า dashboard ผ่าน LINE Login
//
// ⚠️ ตั้งชื่อขึ้นต้นด้วย Admin เพราะ Better Auth ใช้ชื่อ default ว่า user/session/
// account/verification ซึ่ง `user` จะไปชนกับ model User ข้างบน (= ผู้ติดตามบอทใน LINE)
// คนละความหมายกันสิ้นเชิง ห้ามให้ปนกัน
//
// field ทั้งหมดคัดลอกตามนิยามใน @better-auth/core/dist/db/get-tables.mjs ของเวอร์ชัน 1.6.29
// ห้ามแก้ชื่อ field เอง ถ้าอัปเกรด Better Auth ต้องเทียบไฟล์นั้นใหม่
// ===========================================================================

model AdminUser {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions AdminSession[]
  accounts AdminAccount[]
}

model AdminSession {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminAccount {
  id                    String    @id @default(uuid())
  accountId             String // สำหรับ provider "line" ค่านี้คือ sub = LINE userId
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminVerification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// กัน LINE ส่ง event ซ้ำ (retry / redelivery) แล้วระบบทำงานซ้ำ
// ทุก event ที่ LINE ส่งมามี webhookEventId ที่ไม่ซ้ำกัน ใช้เป็น dedup key ได้เลย
// ถ้าไม่มีตารางนี้ event ที่ถูกส่งซ้ำจะเรียก Gemini ใหม่ + เขียน ChatHistory ซ้ำ
model ProcessedEvent {
  webhookEventId String   @id                    // ใช้เป็น PK เลย = ได้ unique index ในตัว
  processedAt    DateTime @default(now())

  // สำหรับงานล้างแถวเก่า
  @@index([processedAt])
}

model ChatHistory {
  id        String   @id @default(uuid())
  lineId    String   // ไอดีของคนคุย (จาก LINE)
  role      String   // ระบุว่าเป็น "user" (คนพิมพ์) หรือ "model" (บอทตอบ)
  message   String   // ข้อความที่คุยกัน
  createdAt DateTime @default(now())

  // สร้าง Index เพื่อให้การค้นหาประวัติและลบประวัติเก่าทำได้เร็วขึ้น
  @@index([lineId, createdAt])
}

// ===========================================================================
// ลงทะเบียนผ่านเว็บ แล้วตอบบัตรสมาชิกกลับได้ฟรีด้วย Account Link ของ LINE
//
// ปัญหาที่แก้: หน้าเว็บฟอร์มไม่มี replyToken ในมือ ถ้าจะส่งบัตรสมาชิกกลับต้อง push
// ซึ่งกินโควตาข้อความ แต่ flow account link ของ LINE จบด้วย event `accountLink`
// ที่ "มี replyToken ติดมาด้วย" → ตอบ Flex ได้ฟรี (LINE ไม่นับ reply ในโควตา)
//
// ลำดับ: พิมพ์ "ลงทะเบียน" ในแชท → ออก linkToken → reply ลิงก์ฟอร์ม
//        → กรอกเสร็จ → สร้าง nonce → เด้งไป access.line.me → LINE ยิง accountLink
//        → เอา nonce มาเปิดแถวนี้ → reply บัตรสมาชิก
//
// ⚠️ ค่าที่โผล่ใน URL (?s=...) คือ id ของแถวนี้ ไม่ใช่ linkToken
//    linkToken ห้ามหลุดไปอยู่ในลิงก์ เพราะเป็นกุญแจของพิธีกรรมฝั่ง LINE
// ===========================================================================
model RegisterSession {
  id        String @id // สุ่มเอง ใช้เป็นพารามิเตอร์ ?s= ในลิงก์ฟอร์ม
  lineId    String // เจ้าของเซสชัน — ได้จาก event ในแชท ไม่ใช่จากฟอร์ม
  linkToken String // ของ LINE อายุ 10 นาที ใช้ได้ครั้งเดียว เก็บฝั่งเซิร์ฟเวอร์เท่านั้น

  /// สร้างตอนกดส่งฟอร์ม — ใช้จับคู่กับ event accountLink ที่ LINE ส่งกลับมา
  /// unique เพราะถ้าซ้ำแปลว่าจับคู่ผิดคน = เขียนข้อมูลให้ผิดคน
  nonce String? @unique

  /// pending = ออกลิงก์แล้วยังไม่กรอก, submitted = กรอกแล้วรอ LINE ยืนยัน, linked = จบแล้ว
  status String @default("pending")

  // ข้อมูลที่กรอก — พักไว้ตรงนี้ก่อน ยังไม่เขียนลง User
  // เพราะถ้า LINE ยืนยันไม่ผ่าน (result = failed) ก็ไม่ควรนับว่าลงทะเบียนสำเร็จ
  fullName String?
  phone    String?
  birthday String?

  /// ตั้งเท่าอายุ linkToken (10 นาที) — เลยกำหนดแล้ว LINE จะไม่ยิง webhook ให้เลย
  /// ปล่อยให้กดส่งฟอร์มได้จะยิ่งงงกว่า จึงตัดจบที่ฝั่งเราก่อน
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lineId])
  @@index([expiresAt])
}
