# ---------------------------------------------------------------
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง — อย่า commit .env
# ---------------------------------------------------------------

# LINE Messaging API (LINE Developers Console > Channel > Basic settings / Messaging API)
# ⚠️ ทั้งสองตัวนี้ไม่มีค่า default — ถ้าไม่ตั้ง ระบบจะ throw ตั้งแต่ตอน start (ตั้งใจให้เป็นแบบนั้น)
#    และ next build จะพังด้วย เพราะ Next รัน route module ตอน collect page data
CHANNEL_SECRET=
CHANNEL_ACCESS_TOKEN=

# LIFF (LINE Developers Console > LIFF)
# รูปแบบคือ {channelId}-{suffix} โดย channelId คือ LINE Login channel ที่ LIFF app อยู่ใต้
NEXT_PUBLIC_LIFF_ID=

# LINE Login channel — ใช้ทั้งล็อกอินเข้า dashboard (H6) และ verify ID token ของ LIFF (H7)
# ⚠️ คนละ channel กับ Messaging API ข้างบน — CHANNEL_SECRET ใช้แทนกันไม่ได้
# Channel ID = ส่วนหน้าของ NEXT_PUBLIC_LIFF_ID
# ต้องลง Callback URL ในแท็บ LINE Login ของ channel นี้ด้วย:
#   http://localhost:3000/api/auth/callback/line
#   https://<โดเมน-production>/api/auth/callback/line
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Better Auth — ระบบล็อกอินของ dashboard
# BETTER_AUTH_SECRET สุ่มเอง: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# BETTER_AUTH_URL ต้องเป็น URL จริงของแต่ละสภาพแวดล้อม (dev = http://localhost:3000)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# LINE userId ที่มีสิทธิ์เข้า dashboard — คั่นด้วย comma ถ้ามีหลายคน
# จำเป็นต้องมี เพราะลำพัง LINE Login แปลว่าใครมีบัญชี LINE ก็ล็อกอินได้
ADMIN_LINE_IDS=

# Postgres
# DATABASE_URL ใช้ตอนรันจริง (ผ่าน connection pooler ได้)
# DIRECT_URL ใช้ตอน prisma migrate ต้องเป็นการต่อตรงไม่ผ่าน pooler
DATABASE_URL=
DIRECT_URL=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Typhoon ASR (https://opentyphoon.ai)
# ถ้าไม่ตั้ง ระบบจะยังทำงานได้ปกติ แต่ข้อความเสียงจะตอบว่า "ระบบถอดเสียงยังไม่พร้อมใช้งาน"
# (ต่างจาก CHANNEL_* ที่ถ้าไม่ตั้งจะ throw ทันที เพราะเป็นเรื่องความปลอดภัย)
TYPHOON_API_KEY=

# URL สาธารณะของเว็บนี้ — ใช้ประกอบลิงก์ฟอร์มลงทะเบียนที่ส่งเข้าแชท LINE
# ต้องเป็น https ที่เปิดจากมือถือผู้ใช้ได้จริง (dev = โดเมน ngrok, prod = โดเมนจริง)
# ถ้าไม่ตั้ง ระบบอื่นยังทำงานปกติ แต่พิมพ์ "ลงทะเบียน" ในแชทแล้วบอทจะตอบว่าระบบขัดข้อง
APP_BASE_URL=
