# ---------------------------------------------------------------
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง — อย่า commit .env
# ---------------------------------------------------------------

# LINE Messaging API (LINE Developers Console > Channel > Basic settings / Messaging API)
# ⚠️ ทั้งสองตัวนี้ไม่มีค่า default — ถ้าไม่ตั้ง ระบบจะ throw ตั้งแต่ตอน start (ตั้งใจให้เป็นแบบนั้น)
#    และ next build จะพังด้วย เพราะ Next รัน route module ตอน collect page data
CHANNEL_SECRET=
CHANNEL_ACCESS_TOKEN=

# LIFF (LINE Developers Console > LIFF)
NEXT_PUBLIC_LIFF_ID=

# Postgres
# DATABASE_URL ใช้ตอนรันจริง (ผ่าน connection pooler ได้)
# DIRECT_URL ใช้ตอน prisma migrate ต้องเป็นการต่อตรงไม่ผ่าน pooler
DATABASE_URL=
DIRECT_URL=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Typhoon ASR (https://opentyphoon.ai)
# ถ้าไม่ตั้ง ระบบจะยังทำงานได้ปกติ แต่ข้อความเสียงจะตอบว่า "ระบบถอดเสียงยังไม่พร้อมใช้งาน"
# (ต่างจาก CHANNEL_* ที่ถ้าไม่ตั้งจะ throw ทันที เพราะเป็นเรื่องความปลอดภัย)
TYPHOON_API_KEY=
